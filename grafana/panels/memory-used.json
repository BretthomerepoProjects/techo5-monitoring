{
  "id": 4,
  "title": "Memory used",
  "type": "gauge",
  "gridPos": {
    "x": 6,
    "y": 1,
    "w": 4,
    "h": 7
  },
  "datasource": {
    "type": "prometheus",
    "uid": "REPLACE_WITH_PROMETHEUS_UID"
  },
  "targets": [
    {
      "refId": "A",
      "expr": "100*(1-node_memory_MemAvailable_bytes{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"REPLACE_WITH_HOST\"}/node_memory_MemTotal_bytes{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"REPLACE_WITH_HOST\"})",
      "legendFormat": "",
      "datasource": {
        "type": "prometheus",
        "uid": "REPLACE_WITH_PROMETHEUS_UID"
      },
      "instant": true,
      "range": false
    }
  ],
  "description": "100 × (1 − available RAM / total RAM). Reclaimable cache is not treated as exhausted memory.",
  "fieldConfig": {
    "defaults": {
      "unit": "percent",
      "noValue": "No data",
      "decimals": 1,
      "color": {
        "mode": "thresholds"
      },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "green",
            "value": null
          },
          {
            "color": "yellow",
            "value": 75
          },
          {
            "color": "red",
            "value": 90
          }
        ]
      },
      "min": 0,
      "max": 100
    },
    "overrides": []
  },
  "options": {
    "reduceOptions": {
      "values": false,
      "calcs": [
        "lastNotNull"
      ],
      "fields": ""
    },
    "orientation": "auto",
    "showThresholdLabels": false,
    "showThresholdMarkers": true,
    "sizing": "auto"
  }
}
