{
  "id": null,
  "uid": "satellites-system-health",
  "title": "Satellites · System Health",
  "description": "Compact fleet overview. One automatically repeated row per selected satellite. CPU and memory gauges, Wi-Fi throughput, data storage and neutral load averages. Only configured Prometheus targets are shown; missing satellites are not invented. UTC display, 60-second refresh.",
  "tags": [
    "system-health",
    "satellites"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "satellite",
        "label": "Satellites",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\"}, host)",
        "query": {
          "query": "label_values(up{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\"}, host)",
          "refId": "SatelliteVariable"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "System health dashboards",
      "type": "dashboards",
      "tags": [
        "system-health"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "$satellite",
      "type": "row",
      "collapsed": false,
      "repeat": "satellite",
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Status",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 2,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Prometheus scrape availability; not a full voice-service health check.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "CPU busy",
      "type": "gauge",
      "gridPos": {
        "x": 2,
        "y": 1,
        "w": 4,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(1-avg by(host)(rate(node_cpu_seconds_total{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\",mode=\"idle\"}[5m])))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Percent busy across reported CPUs, 5-minute rate. Load average is separate and can include kernel waits.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      }
    },
    {
      "id": 4,
      "title": "Memory used",
      "type": "gauge",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 4,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(1-node_memory_MemAvailable_bytes{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\"}/node_memory_MemTotal_bytes{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "100 × (1 − available RAM / total RAM). Reclaimable cache is not treated as exhausted memory.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      }
    },
    {
      "id": 5,
      "title": "Wi-Fi throughput",
      "type": "timeseries",
      "description": "Receive and transmit bits/second on wlan0. Five-minute rates; 60-second exporter scrape interval.",
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "8*rate(node_network_receive_bytes_total{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\",device=\"wlan0\"}[5m])",
          "legendFormat": "Receive",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "8*rate(node_network_transmit_bytes_total{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\",device=\"wlan0\"}[5m])",
          "legendFormat": "Transmit",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Receive"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Transmit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Data storage used",
      "type": "gauge",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(1-node_filesystem_avail_bytes{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\",mountpoint=\"/data\"}/node_filesystem_size_bytes{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\",mountpoint=\"/data\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Space unavailable to the service account on /data. Root filesystem is separate.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      }
    },
    {
      "id": 7,
      "title": "Load · 1 / 5 / 15m",
      "type": "stat",
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\"}",
          "legendFormat": "1m",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "node_load5{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\"}",
          "legendFormat": "5m",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "node_load15{job=~\"(dot.*|spot.*|show.*|satellite.*)-node\",host=~\"${satellite:regex}\"}",
          "legendFormat": "15m",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Load includes runnable and uninterruptible-wait tasks. On these Android-derived kernels, driver waits can raise load while CPU is idle. No overload threshold is applied.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    }
  ]
}
